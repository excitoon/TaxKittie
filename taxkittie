#!/usr/bin/env python3
"""TaxKittie — Russian tax-return tool for an ИП or ООО across every regime.

Compute the tax for a year and entity, print a bilingual RU/EN summary, and —
for the regimes that file a return — emit the ФНС XML envelope.

    Entities : ИП (sole proprietor) · ООО (organisation)
    Regimes  : ОСНО · УСН (доходы / доходы-расходы) · ПСН · АУСН · НПД · ЕСХН
    Plus     : страховые взносы (за себя + с зарплат), 6-НДФЛ agent withholding,
               пени (ст. 75) and fines (ст. 119 / 122).

    ./taxkittie compute --regime osno --entity ip  --year 2023 --income 1000000
    ./taxkittie compute --regime usn  --object dohody --year 2025 --income 3000000
    ./taxkittie compute --regime osno --entity org --year 2025 --income 8000000 --expenses 5000000
    ./taxkittie xml      --regime osno --entity ip  --year 2024 --income 0 --out r.xml

Single-file Python 3 tool — stdlib only, Python >= 3.11.  All monetary values ₽.
"""

from __future__ import annotations

import argparse
import math
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from datetime import date, datetime, timedelta

__version__ = "0.3.0"


