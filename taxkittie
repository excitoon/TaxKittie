def _latest(table: dict, year: int):
    """Value for `year`, or the most recent earlier year present in `table`."""
    if year in table:
        return table[year]
    earlier = [y for y in table if y <= year]
    return table[max(earlier)] if earlier else table[min(table)]


def fixed_contributions(year: int) -> int:
    return _latest(FIXED_CONTRIBUTIONS, year)


def ndfl_brackets(year: int) -> list[tuple[float, float]]:
    return _latest(NDFL_BRACKETS, year)


def mrot(year: int) -> int:
    return _latest(MROT, year)


# ════════════════════════════════ model ════════════════════════════════
@dataclass
class Taxpayer:
    """An ИП (individual) or an ООО (organisation). For an ИП use the ФИО fields;
    for an ООО set kind="org" and `name`."""

    last_name: str = ""
    first_name: str = ""
    patronymic: str = ""
    inn: str = ""
    kind: str = "ip"                  # "ip" | "org"
    name: str = ""                    # organisation short name (when kind == "org")
    kpp: str = ""                     # КПП (organisations)
    ogrn: str = ""                    # ОГРН (organisations)
    ogrnip: str = ""                  # ОГРНИП (entrepreneurs)
    phone: str = ""
    tax_authority_code: str = ""      # код налогового органа (e.g. "7701")
    oktmo: str = ""                   # ОКТМО (e.g. "45000000")
    okved: str = "62.01"             # ОКВЭД основного вида деятельности

    @property
    def is_org(self) -> bool:
        return self.kind == "org"

    @property
    def full_name(self) -> str:
        if self.is_org:
            return self.name or "—"
        return " ".join(p for p in (self.last_name, self.first_name, self.patronymic) if p)


@dataclass
class Filing:
    """A single tax-year filing. Most inputs are optional and read per regime."""

    year: int
    taxpayer: Taxpayer
    regime: str = "osno"                       # osno | usn | psn | ausn | npd | eshn
    income: int = 0                            # outgoing revenue / доход, ₽
    expenses: int | None = None                # расходы; for ОСНО-ИП: documented (None → 20 %)
    usn_object: str = "dohody"                # dohody | dohody-rashody
    region_rate: float | None = None           # reduced regional УСН rate, if any
    potential_income: int = 0                  # ПСН: потенциально возможный годовой доход
    income_from_legal: int = 0                 # НПД: share billed to ИП/юрлиц (6 %)
    advance_payments: int = 0                  # авансы / уплаченный налог в течение года, ₽
    vat_input: int = 0                         # входящий НДС к вычету (ОСНО), ₽
    employees: list[int] = field(default_factory=list)  # monthly gross salary per employee
    is_msp: bool = False                       # in the МСП registry (reduced payroll tariff)
    correction_number: int = 0                 # номер корректировки (0 = первичная)

    def is_nil(self) -> bool:
        return not (self.income or self.potential_income or self.employees)


@dataclass
class TaxResult:
    regime: str
    year: int
    income: int
    tax_base: int = 0
    tax: int = 0                  # main regime tax, исчисленный
    reduction: int = 0           # взносы credit applied (УСН доходы / ПСН)
    tax_due: int = 0             # regime tax to pay
    vat: int = 0                 # НДС to pay
    contributions_self: int = 0  # ИП взносы за себя
    contributions_payroll: int = 0  # employer взносы с зарплат
    ndfl_withheld: int = 0       # 6-НДФЛ withheld from salaries, to remit
    peni: int = 0
    fine_119: int = 0
    fine_122: int = 0
    detail: list[tuple[str, str, str]] = field(default_factory=list)
    notes: list[str] = field(default_factory=list)

    @property
    def total_payable(self) -> int:
        return (self.tax_due + self.vat + self.contributions_self
                + self.contributions_payroll + self.ndfl_withheld
                + self.peni + self.fine_119 + self.fine_122)


# ════════════════════════════════ tax ════════════════════════════════
def professional_deduction(f: Filing) -> int:
    """ОСНО-ИП: 20 % standard deduction, or documented expenses if larger (ст. 221)."""
    standard = round(f.income * STANDARD_PROFESSIONAL_DEDUCTION_RATE)
    if f.expenses is None:
        return standard
    return max(standard, f.expenses)


def ndfl_on_base(base: int, year: int) -> int:
    """Progressive НДФЛ on a tax base for the given year (per-band, not flat)."""
    tax, lower = 0.0, 0.0
    for upper, rate in ndfl_brackets(year):
        if base <= lower:
            break
        tax += (min(base, upper) - lower) * rate
        lower = upper
    return round(tax)


def ip_contributions(year: int, profit_base: int) -> tuple[int, int]:
    """ИП взносы за себя: (fixed, extra-1 %). The 1 % runs on profit over 300 000 ₽,
    capped per year. `profit_base` is the regime's income/profit measure."""
    fixed = fixed_contributions(year)
    over = max(profit_base - CONTRIB_EXTRA_THRESHOLD, 0)
    extra = min(round(over * CONTRIB_EXTRA_RATE), _latest(CONTRIB_EXTRA_CAP, year))
    return fixed, extra


def payroll_contributions(salaries: list[int], year: int, *, msp: bool = False) -> int:
    """Employer страховые взносы (единый тариф) on a list of monthly gross salaries,
    assuming 12 equal months. МСП: 30 % up to 1.5×МРОТ/month, 15 % above (2025+)."""
    limit = _latest(PAYROLL_BASE_LIMIT, year)
    threshold = PAYROLL_MSP_MROT_MULT * mrot(year)
    total = 0.0
    for monthly in salaries:
        if msp:
            below = min(monthly, threshold)
            above = max(monthly - threshold, 0)
            total += (below * PAYROLL_RATE_REGULAR + above * PAYROLL_MSP_RATE_OVER) * 12
        else:
            annual = monthly * 12
            below = min(annual, limit)
            above = max(annual - limit, 0)
            total += below * PAYROLL_RATE_REGULAR + above * PAYROLL_RATE_OVER
    return round(total)


def payroll_ndfl(salaries: list[int], year: int) -> int:
    """НДФЛ a tax agent withholds from employees' annual salaries (6-НДФЛ)."""
    return sum(ndfl_on_base(monthly * 12, year) for monthly in salaries)


def usn_vat(income: int, year: int) -> tuple[int, list[str]]:
    """НДС a УСН payer owes once income exceeds the exemption limit (2025+)."""
    if year < 2025 or income <= USN_VAT_FREE_LIMIT:
        return 0, []
    rate = next((r for cap, r in USN_VAT_SPECIAL if income <= cap), USN_VAT_SPECIAL[-1][1])
    note = (f"Доход > {USN_VAT_FREE_LIMIT // 1_000_000} млн ₽ → НДС обязателен "
            f"(спецставка {rate:.0%} без вычета, либо 20 % с вычетом)")
    return round(income * rate), [note]


def filing_deadline(regime: str, is_org: bool, year: int) -> date | None:
    """Annual-return filing deadline, or None for regimes without a declaration."""
    if regime == "osno" and not is_org:                  # 3-НДФЛ
        return date(year + 1, 4, 30)
    if regime == "usn":
        return date(year + 1, 3, 25) if is_org else date(year + 1, 4, 25)
    if regime == "eshn" or (regime == "osno" and is_org):  # ЕСХН / налог на прибыль
        return date(year + 1, 3, 25)
    return None                                          # ПСН / АУСН / НПД — no return


def payment_deadline(regime: str, is_org: bool, year: int) -> date | None:
    if regime == "osno" and not is_org:
        return date(year + 1, 7, 15)
    if regime == "usn" or regime == "eshn":
        return date(year + 1, 3, 28) if is_org else date(year + 1, 4, 28)
    if regime == "osno" and is_org:
        return date(year + 1, 3, 28)
    return None


def _key_rate_on(day: date) -> float:
    rate = KEY_RATE_HISTORY[0][1]
    for (y, m, d), value in KEY_RATE_HISTORY:
        if date(y, m, d) <= day:
            rate = value
        else:
            break
    return rate


def peni(amount: int, due: date, paid: date) -> int:
    """Пени (ст. 75): 1/300 of the CB key rate per day, day-after-deadline → payment."""
    if amount <= 0 or paid <= due:
        return 0
    total, day = 0.0, due + timedelta(days=1)
    while day <= paid:
        total += amount * _key_rate_on(day) * PENI_FRACTION
        day += timedelta(days=1)
    return round(total)


def _started_months(start: date, end: date) -> int:
    if end <= start:
        return 0
    months = (end.year - start.year) * 12 + (end.month - start.month)
    if end.day > start.day:
        months += 1
    return max(months, 1)


def fine_119(unpaid_tax: int, deadline: date, filing_date: date) -> int:
    """Late-filing fine (ст. 119): 5 %/started month, min 1000, cap 30 %."""
    if filing_date <= deadline:
        return 0
    pct = min(_started_months(deadline, filing_date) * FINE_119_RATE_PER_MONTH, FINE_119_CAP)
    return max(round(unpaid_tax * pct), FINE_119_MIN)


def fine_122(unpaid_tax: int, paid_before_filing: bool) -> int:
    """Non-payment fine (ст. 122): 20 %, avoided if tax+пени paid before filing (ст. 81)."""
    if paid_before_filing or unpaid_tax <= 0:
        return 0
    return round(unpaid_tax * FINE_122_RATE)


def _rub(amount: int) -> str:
    return f"{amount:,}".replace(",", " ") + " ₽"


def _pct(rate: float) -> str:
    return f"{rate * 100:.2f}".rstrip("0").rstrip(".") + " %"


# ── per-regime computation ──────────────────────────────────────────────
# Each returns the regime tax/base, the profit measure that the ИП 1 % runs on,
# whether a взносы credit applies, the НДС, render rows and notes.

def _compute_osno(f: Filing) -> dict:
    if f.taxpayer.is_org:                                # налог на прибыль
        base = max(f.income - (f.expenses or 0), 0)
        rate = _latest(PROFIT_RATE, f.year)
        tax = round(base * rate)
        vat = max(round(f.income * VAT_STANDARD_RATE) - f.vat_input, 0)
        rows = [
            ("Доходы", "Income", _rub(f.income)),
            ("Расходы", "Expenses", _rub(f.expenses or 0)),
            ("Налоговая база", "Tax base", _rub(base)),
            ("Ставка налога на прибыль", "Profit-tax rate", _pct(rate)),
            ("Налог на прибыль", "Profit tax", _rub(tax)),
            ("НДС к уплате (20 %)", "VAT payable", _rub(vat)),
        ]
        return dict(base=base, tax=tax, profit_base=base, credit=False, vat=vat,
                    rows=rows, notes=["НДС упрощён: 20 % с доходов минус входящий НДС"])
    # ОСНО ИП → 3-НДФЛ
    deduction = professional_deduction(f)
    base = max(f.income - deduction, 0)
    tax = ndfl_on_base(base, f.year)
    rows = [
        ("Доход от предпринимательской деятельности", "Business income", _rub(f.income)),
        ("Профессиональный налоговый вычет", "Professional deduction", _rub(deduction)),
        ("Налоговая база", "Tax base", _rub(base)),
        ("НДФЛ исчисленный", "Personal income tax", _rub(tax)),
    ]
    return dict(base=base, tax=tax, profit_base=base, credit=False, vat=0, rows=rows, notes=[])


def _compute_usn(f: Filing) -> dict:
    obj = f.usn_object
    rate = f.region_rate if f.region_rate is not None else USN_RATE[obj]
    if obj == "dohody":
        base = f.income
        tax = round(base * rate)
        rows = [("Доходы", "Income", _rub(f.income)),
                ("Ставка УСН «доходы»", "USN rate", _pct(rate)),
                ("Налог исчисленный", "Tax", _rub(tax))]
        credit = True
    else:
        base = max(f.income - (f.expenses or 0), 0)
        normal = round(base * rate)
        minimum = round(f.income * USN_MIN_TAX_RATE)
        tax = max(normal, minimum)
        rows = [("Доходы", "Income", _rub(f.income)),
                ("Расходы", "Expenses", _rub(f.expenses or 0)),
                ("Налоговая база", "Tax base", _rub(base)),
                ("Ставка УСН «доходы−расходы»", "USN rate", _pct(rate)),
                ("Налог по ставке", "Tax at rate", _rub(normal)),
                ("Минимальный налог (1 %)", "Minimum tax", _rub(minimum)),
                ("Налог исчисленный", "Tax", _rub(tax))]
        credit = False
    vat, vat_notes = usn_vat(f.income, f.year)
    if vat:
        rows.append(("НДС к уплате", "VAT payable", _rub(vat)))
    return dict(base=base, tax=tax, profit_base=base, credit=credit, vat=vat,
                rows=rows, notes=vat_notes)


def _compute_psn(f: Filing) -> dict:
    tax = round(f.potential_income * PSN_RATE)
    rows = [("Потенциальный доход", "Potential income", _rub(f.potential_income)),
            ("Стоимость патента (6 %)", "Patent cost", _rub(tax))]
    return dict(base=f.potential_income, tax=tax, profit_base=f.potential_income,
                credit=True, vat=0, rows=rows,
                notes=["ПСН не подаёт декларацию; стоимость можно уменьшить на взносы"])


def _compute_ausn(f: Filing) -> dict:
    obj = f.usn_object
    rate = AUSN_RATE[obj]
    if obj == "dohody":
        base, tax = f.income, round(f.income * rate)
    else:
        base = max(f.income - (f.expenses or 0), 0)
        tax = max(round(base * rate), round(f.income * AUSN_MIN_TAX_RATE))
    rows = [("Доходы", "Income", _rub(f.income)),
            (f"Ставка АУСН ({'доходы' if obj == 'dohody' else 'доходы−расходы'})",
             "AUSN rate", _pct(rate)),
            ("Налог исчисленный", "Tax", _rub(tax))]
    return dict(base=base, tax=tax, profit_base=base, credit=False, vat=0, rows=rows,
                notes=["АУСН: без декларации и без страховых взносов"])


def _compute_npd(f: Filing) -> dict:
    from_ind = max(f.income - f.income_from_legal, 0)
    tax = round(from_ind * NPD_RATE["individuals"] + f.income_from_legal * NPD_RATE["legal"])
    rows = [("Доход от физлиц (4 %)", "Income from individuals", _rub(from_ind)),
            ("Доход от юрлиц/ИП (6 %)", "Income from legal entities", _rub(f.income_from_legal)),
            ("Налог на профдоход", "Professional-income tax", _rub(tax))]
    return dict(base=f.income, tax=tax, profit_base=0, credit=False, vat=0, rows=rows,
                notes=["НПД: без декларации и без взносов; лимит дохода 2,4 млн ₽/год"])


def _compute_eshn(f: Filing) -> dict:
    base = max(f.income - (f.expenses or 0), 0)
    tax = round(base * ESHN_RATE)
    rows = [("Доходы", "Income", _rub(f.income)),
            ("Расходы", "Expenses", _rub(f.expenses or 0)),
            ("Налоговая база", "Tax base", _rub(base)),
            ("ЕСХН (6 %)", "ESHN tax", _rub(tax))]
    return dict(base=base, tax=tax, profit_base=base, credit=False, vat=0, rows=rows,
                notes=["ЕСХН — плательщик НДС, если не получено освобождение (ст. 145)"])


_REGIMES = {
    "osno": _compute_osno, "usn": _compute_usn, "psn": _compute_psn,
    "ausn": _compute_ausn, "npd": _compute_npd, "eshn": _compute_eshn,
}
# Which (regime, entity) combinations are valid.
_REGIME_ENTITIES = {
    "osno": {"ip", "org"}, "usn": {"ip", "org"}, "eshn": {"ip", "org"},
    "psn": {"ip"}, "ausn": {"ip", "org"}, "npd": {"ip"},
}
REGIME_LABEL = {
    "osno": "ОСНО / OSNO (general)", "usn": "УСН / USN (simplified)",
    "psn": "ПСН / PSN (patent)", "ausn": "АУСН / AUSN (automated)",
    "npd": "НПД / NPD (self-employed)", "eshn": "ЕСХН / ESHN (agricultural)",
}


def compute(
    f: Filing,
    *,
    filing_date: date | None = None,
    payment_date: date | None = None,
    paid_before_filing: bool = False,
) -> TaxResult:
    """Compute a filing for its regime, plus взносы, payroll and (with dates) penalties."""
    if f.regime not in _REGIMES:
        raise ValueError(f"unknown regime {f.regime!r}; choose from {', '.join(_REGIMES)}")
    entity = "org" if f.taxpayer.is_org else "ip"
    if entity not in _REGIME_ENTITIES[f.regime]:
        raise ValueError(f"{f.regime.upper()} is not available for an {entity.upper()}")

    parts = _REGIMES[f.regime](f)
    r = TaxResult(f.regime, f.year, f.income, tax_base=parts["base"], tax=parts["tax"],
                  vat=parts["vat"], detail=list(parts["rows"]), notes=list(parts["notes"]))

    # ИП взносы за себя (regimes that levy them; not АУСН/НПД).
    has_employees = bool(f.employees)
    if not f.taxpayer.is_org and f.regime not in ("ausn", "npd"):
        fixed, extra = ip_contributions(f.year, parts["profit_base"])
        r.contributions_self = fixed + extra
        r.detail.append(("Страховые взносы ИП «за себя»", "ИП self-contributions",
                         f"{_rub(fixed)} + 1 % {_rub(extra)} = {_rub(fixed + extra)}"))

    # Payroll: employer взносы + 6-НДФЛ withholding.
    if has_employees:
        r.contributions_payroll = payroll_contributions(f.employees, f.year, msp=f.is_msp)
        r.ndfl_withheld = payroll_ndfl(f.employees, f.year)
        r.detail.append((f"Зарплатные взносы ({len(f.employees)} сотр.{', МСП' if f.is_msp else ''})",
                         "Employer payroll contributions", _rub(r.contributions_payroll)))
        r.detail.append(("НДФЛ налогового агента (с зарплат)", "Agent НДФЛ withheld",
                         _rub(r.ndfl_withheld)))

    # Reduction by взносы for УСН «доходы» / ПСН.
    raw_tax = r.tax
    if parts["credit"]:
        credit_pool = r.contributions_self + r.contributions_payroll
        cap = raw_tax if (not f.taxpayer.is_org and not has_employees) else round(raw_tax * 0.5)
        r.reduction = min(credit_pool, cap)
        if r.reduction:
            r.detail.append(("Уменьшение на взносы", "Reduced by contributions",
                             f"−{_rub(r.reduction)}"))
    r.tax_due = max(raw_tax - r.reduction - f.advance_payments, 0)

    # Penalties (only regimes that file a return with tax due).
    pay_due = payment_deadline(f.regime, f.taxpayer.is_org, f.year)
    file_due = filing_deadline(f.regime, f.taxpayer.is_org, f.year)
    if payment_date is not None and pay_due is not None and r.tax_due > 0:
        r.peni = peni(r.tax_due, pay_due, payment_date)
    if filing_date is not None and file_due is not None:
        r.fine_119 = fine_119(r.tax_due, file_due, filing_date)
        r.fine_122 = fine_122(r.tax_due, paid_before_filing)
    return r


# ════════════════════════════════ render ════════════════════════════════
def render(f: Filing, r: TaxResult, lang: str = "both") -> str:
    """Render a filing as aligned bilingual text. lang: "ru", "en" or "both"."""
    head = [
        ("Налогоплательщик", "Taxpayer", f.taxpayer.full_name),
        ("ИНН", "INN", f.taxpayer.inn or "—"),
    ]
    if f.taxpayer.is_org:
        head.append(("КПП", "KPP", f.taxpayer.kpp or "—"))
    else:
        head.append(("ОГРНИП", "OGRNIP", f.taxpayer.ogrnip or "—"))
    head += [
        ("Налоговый период", "Tax year", str(f.year)),
        ("Система налогообложения", "Tax regime", REGIME_LABEL[f.regime]),
        ("Вид документа", "Document type",
         "первичный / primary" if f.correction_number == 0
         else f"корректировка №{f.correction_number} / amended"),
    ]
    payable = [("Налог к уплате", "Tax payable", _rub(r.tax_due))]
    if r.vat:
        payable.append(("НДС к уплате", "VAT payable", _rub(r.vat)))
    if r.peni or r.fine_119 or r.fine_122:
        payable += [
            ("Пени (ст. 75)", "Late-payment interest", _rub(r.peni)),
            ("Штраф за непредставление (ст. 119)", "Late-filing fine", _rub(r.fine_119)),
            ("Штраф за неуплату (ст. 122)", "Non-payment fine", _rub(r.fine_122)),
        ]
    payable.append(("ИТОГО к уплате в бюджет", "TOTAL payable to budget", _rub(r.total_payable)))

    rows = head + [("", "", "")] + r.detail + [("", "", "")] + payable
    if lang == "ru":
        labels = [ru for ru, _, _ in rows]
    elif lang == "en":
        labels = [en for _, en, _ in rows]
    else:
        labels = [f"{ru} / {en}" if ru else "" for ru, en, _ in rows]
    width = max(len(label) for label in labels)
    body = "\n".join(f"{label:<{width}}  {val}".rstrip()
                     for label, (_, _, val) in zip(labels, rows))
    name = f.taxpayer.full_name
    title = " · ".join(p for p in (f.regime.upper(), str(f.year), name) if p and p != "—")
    out = f"{title}\n{'─' * len(title)}\n{body}"
    if r.notes:
        out += "\n\n" + "\n".join(f"ℹ {n}" for n in r.notes)
    return out


# ════════════════════════════════ ФНС XML ════════════════════════════════
# ⚠  Builds the *documented* КНД envelope. Element names, the attribute set and
# the format version (ВерсФорм) differ per year and are fixed by the ФНС приказ.
# VALIDATE against the official year XSD before submitting. XML is implemented
# for the two returns an ИП/ООО most often files itself: 3-НДФЛ and УСН.
FORMAT_VERSION = "5.10"               # placeholder — set to the official ВерсФорм
PROGRAM_VERSION = f"TaxKittie {__version__}"
TAX_PERIOD_YEAR = "34"
PLACE_IP_RESIDENCE = "320"
PLACE_USN_IP = "120"
PLACE_USN_ORG = "210"


def _money(amount: int) -> str:
    return f"{amount}.00"


def _np_element(parent: ET.Element, tp: Taxpayer) -> None:
    """Append the taxpayer block — НПЮЛ for an org, НПФЛ for an individual."""
    if tp.is_org:
        ET.SubElement(parent, "НПЮЛ", {"НаимОрг": tp.name, "ИННЮЛ": tp.inn, "КПП": tp.kpp})
    else:
        fl = ET.SubElement(parent, "НПФЛ", {"ИННФЛ": tp.inn, "Тлф": tp.phone})
        ET.SubElement(fl, "ФИО", {"Фамилия": tp.last_name, "Имя": tp.first_name,
                                  "Отчество": tp.patronymic})


def build_ndfl_tree(f: Filing, r: TaxResult, *, doc_date: date) -> ET.Element:
    tp = f.taxpayer
    root = ET.Element("Файл", {
        "ИдФайл": f"NO_NDFL_{tp.tax_authority_code or '0000'}_{tp.inn}_{doc_date:%Y%m%d}",
        "ВерсПрог": PROGRAM_VERSION, "ВерсФорм": FORMAT_VERSION})
    doc = ET.SubElement(root, "Документ", {
        "КНД": "1151020", "ДатаДок": f"{doc_date:%d.%m.%Y}", "Период": TAX_PERIOD_YEAR,
        "ОтчетГод": str(f.year), "КодНО": tp.tax_authority_code,
        "НомКорр": str(f.correction_number), "ПоМесту": PLACE_IP_RESIDENCE})
    _np_element(ET.SubElement(doc, "СвНП", {"ОКТМО": tp.oktmo}), tp)
    decl = ET.SubElement(doc, "Декларация")
    ET.SubElement(decl, "Раздел1", {"КБК": KBK["ndfl_ip"], "ОКТМО": tp.oktmo,
                                    "НалПУ": _money(r.tax_due)})
    ET.SubElement(decl, "Раздел2", {
        "Ставка": "13", "ОбщСумДох": _money(f.income),
        "СумProfВыч": _money(r.tax_base and f.income - r.tax_base or 0),
        "НалБаза": _money(r.tax_base), "НалИсчисл": _money(r.tax),
        "АвансУпл": _money(f.advance_payments), "НалПУ": _money(r.tax_due)})
    ET.SubElement(decl, "Прил3", {"ВидДеят": "01", "ОКВЭД": tp.okved,
                                  "СумДох": _money(f.income),
                                  "СумРасхВсего": _money(f.income - r.tax_base)})
    return root


def build_usn_tree(f: Filing, r: TaxResult, *, doc_date: date) -> ET.Element:
    tp = f.taxpayer
    root = ET.Element("Файл", {
        "ИдФайл": f"NO_USN_{tp.tax_authority_code or '0000'}_{tp.inn}_{doc_date:%Y%m%d}",
        "ВерсПрог": PROGRAM_VERSION, "ВерсФорм": FORMAT_VERSION})
    doc = ET.SubElement(root, "Документ", {
        "КНД": "1152017", "ДатаДок": f"{doc_date:%d.%m.%Y}", "Период": TAX_PERIOD_YEAR,
        "ОтчетГод": str(f.year), "КодНО": tp.tax_authority_code,
        "НомКорр": str(f.correction_number),
        "ПоМесту": PLACE_USN_ORG if tp.is_org else PLACE_USN_IP})
    _np_element(ET.SubElement(doc, "СвНП", {"ОКТМО": tp.oktmo}), tp)
    decl = ET.SubElement(doc, "УпрощСистНал", {
        "ПризНалог": "1" if f.usn_object == "dohody" else "2"})
    kbk = KBK[f"usn_{f.usn_object}"]
    if f.usn_object == "dohody":
        ET.SubElement(decl, "Раздел1.1", {"КБК": kbk, "ОКТМО": tp.oktmo,
                                          "НалПУ": _money(r.tax_due)})
        ET.SubElement(decl, "Раздел2.1.1", {
            "ПризНП": "1", "Ставка": f"{USN_RATE['dohody'] * 100:.0f}",
            "Доход": _money(f.income), "НалИсчисл": _money(r.tax),
            "УменСумВзн": _money(r.reduction), "НалПУ": _money(r.tax_due)})
    else:
        ET.SubElement(decl, "Раздел1.2", {"КБК": kbk, "ОКТМО": tp.oktmo,
                                          "НалПУ": _money(r.tax_due)})
        ET.SubElement(decl, "Раздел2.2", {
            "Ставка": f"{USN_RATE['dohody-rashody'] * 100:.0f}",
            "Доход": _money(f.income), "Расход": _money(f.expenses or 0),
            "НалБаза": _money(r.tax_base), "НалИсчисл": _money(r.tax),
            "НалМин": _money(round(f.income * USN_MIN_TAX_RATE)), "НалПУ": _money(r.tax_due)})
    return root


_XML_BUILDERS = {("osno", "ip"): build_ndfl_tree,
                 ("usn", "ip"): build_usn_tree, ("usn", "org"): build_usn_tree}


def build_tree(f: Filing, r: TaxResult, *, doc_date: date) -> ET.Element:
    key = (f.regime, "org" if f.taxpayer.is_org else "ip")
    if key not in _XML_BUILDERS:
        raise ValueError(
            f"no XML form for {f.regime.upper()} / {key[1].upper()} — "
            "ФНС XML is implemented for 3-НДФЛ (ОСНО-ИП) and УСН only; "
            "ПСН/АУСН/НПД file no return, налог на прибыль/ЕСХН XML is pending")
    return _XML_BUILDERS[key](f, r, doc_date=doc_date)


def to_bytes(f: Filing, r: TaxResult, *, doc_date: date) -> bytes:
    """Return the return as windows-1251 XML bytes (ФНС standard encoding)."""
    root = build_tree(f, r, doc_date=doc_date)
    ET.indent(root, space="  ")
    body = ET.tostring(root, encoding="unicode")
    return ('<?xml version="1.0" encoding="windows-1251"?>\n' + body).encode("windows-1251")


# ════════════════════════════════ КУДиР / books (LaTeX) ════════════════════════
# Income/expense ledgers a taxpayer must keep, rendered as XeLaTeX for Windows:
#   ПСН  → «Книга учёта доходов» (income only, ст. 346.53)
#   УСН  → «КУДиР» (доходы и расходы)
#   ОСНО → «Книга учёта доходов и расходов и хозяйственных операций» (Приказ 86н)
# Compile with:  pdflatex <file>.tex  (Cyrillic via T2A; stock pdfLaTeX, no fonts).
BOOK_TITLE = {
    "psn": ("учёта доходов индивидуального предпринимателя,",
            "применяющего патентную систему налогообложения"),
    "usn": ("учёта доходов и расходов индивидуальных предпринимателей и",
            "организаций, применяющих упрощённую систему налогообложения"),
    "osno": ("учёта доходов и расходов и хозяйственных операций",
             "индивидуального предпринимателя"),
}

_TEX_PREAMBLE = r"""% Compile on Windows:  pdflatex <thisfile>.tex   (run twice if longtable asks)
% Cyrillic via T2A encoding — works with stock pdfLaTeX (MiKTeX / TeX Live),
% no XeLaTeX and no font install needed. Keep the source file UTF-8.
\documentclass[11pt]{article}
\usepackage[T2A]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[russian]{babel}
\usepackage[a4paper,landscape,margin=1.6cm]{geometry}
\usepackage{longtable,array,makecell}
\renewcommand{\arraystretch}{1.35}
\setlength{\parindent}{0pt}
\begin{document}
"""


def _tex_escape(s: str) -> str:
    repl = {"\\": r"\textbackslash{}", "&": r"\&", "%": r"\%", "$": r"\$",
            "#": r"\#", "_": r"\_", "{": r"\{", "}": r"\}",
            "~": r"\textasciitilde{}", "^": r"\textasciicircum{}"}
    return "".join(repl.get(c, c) for c in s)


def _tex_money(amount: int) -> str:
    return f"{amount:,}".replace(",", "\\,") + ",00"


def build_book_tex(f: Filing, operations, *, doc_date: date) -> str:
    """Render the regime's statutory ledger as a XeLaTeX document (string)."""
    if f.regime not in BOOK_TITLE:
        raise ValueError(f"no statutory ledger for {f.regime.upper()} "
                         "(АУСН/НПД keep none); books exist for ПСН, УСН, ОСНО")
    tp = f.taxpayer
    has_exp = f.regime in ("usn", "osno")
    if not operations:
        operations = [("(дата)", "(№ док.)",
                       "Доход от предпринимательской деятельности", f.income, f.expenses or 0)]

    who = (("Организация / ИП", _tex_escape(tp.name)) if tp.is_org
           else ("Индивидуальный предприниматель", _tex_escape(tp.full_name)))
    ident = [who, ("ИНН", _tex_escape(tp.inn) or "—")]
    ident.append(("КПП", _tex_escape(tp.kpp) or "—") if tp.is_org
                 else ("ОГРНИП", _tex_escape(tp.ogrnip) or "—"))
    ident += [("Налоговый орган", _tex_escape(tp.tax_authority_code) or "—"),
              ("ОКВЭД", _tex_escape(tp.okved)), ("Единица измерения", "рубль")]

    if has_exp:
        cols = r"|c|p{3.4cm}|p{8cm}|r|r|"
        header = (r"\bfseries № & \makecell{\bfseries Дата и №\\ \bfseries документа} & "
                  r"\bfseries Содержание операции & \makecell{\bfseries Доходы,\\ \bfseries руб.}"
                  r" & \makecell{\bfseries Расходы,\\ \bfseries руб.} \\")
    else:
        cols = r"|c|p{3.6cm}|p{10cm}|r|"
        header = (r"\bfseries № & \makecell{\bfseries Дата и №\\ \bfseries документа} & "
                  r"\bfseries Содержание операции & \makecell{\bfseries Сумма\\ \bfseries дохода, руб.} \\")

    rows, inc_total, exp_total = [], 0, 0
    for i, (d, doc, desc, inc, exp) in enumerate(operations, 1):
        inc_total += inc
        exp_total += exp
        cell = r"\makecell[l]{" + _tex_escape(str(d)) + r"\\ " + _tex_escape(str(doc)) + r"}"
        line = str(i) + r" & " + cell + r" & " + _tex_escape(str(desc)) + r" & " + _tex_money(inc)
        line += (r" & " + (_tex_money(exp) if exp else "---")) if has_exp else ""
        rows.append("  " + line + r" \\" + "\n  \\hline")
    if has_exp:
        total = (r"  \multicolumn{3}{|r|}{\bfseries Итого за год:} & \bfseries "
                 + _tex_money(inc_total) + r" & \bfseries " + _tex_money(exp_total) + r" \\")
    else:
        total = (r"  \multicolumn{3}{|r|}{\bfseries Итого за год:} & \bfseries "
                 + _tex_money(inc_total) + r" \\")

    if f.regime == "psn":
        note = (r"\textbf{Патентная система (ст.~346.53 НК).} Книга учёта доходов ведётся "
                r"для контроля лимита дохода 60\,млн руб./год. Доход за год: "
                + _tex_money(inc_total) + r" руб.")
    elif f.regime == "usn":
        res = compute(f)
        obj = "доходы" if f.usn_object == "dohody" else "доходы минус расходы"
        note = (r"\textbf{УСН («" + obj + r"»).} Налог к уплате по итогам года: "
                + _tex_money(res.tax_due) + r" руб.")
    else:
        res = compute(f)
        note = (r"\textbf{ОСНО.} Профессиональный вычет (ст.~221 НК): доход "
                + _tex_money(f.income) + r" руб., вычет " + _tex_money(f.income - res.tax_base)
                + r" руб., налоговая база " + _tex_money(res.tax_base) + r" руб., НДФЛ "
                + _tex_money(res.tax) + r" руб.")

    # NB: blank-line entries ("") force LaTeX paragraph breaks between block
    # elements — without them the tabular, heading and note run together.
    title2, title3 = BOOK_TITLE[f.regime]
    p = [_TEX_PREAMBLE,
         r"\begin{center}", r"  {\Large\bfseries КНИГА}\\[4pt]",
         r"  {\large " + title2 + r"}\\", r"  {\large " + title3 + r"}\\[10pt]",
         r"  {\large\bfseries за " + str(f.year) + r" год}", r"\end{center}", "",
         r"\vspace{1.4em}",
         r"\begin{tabular}{@{}>{\bfseries}p{6.5cm} p{16cm}@{}}",
         "  " + " \\\\\n  ".join(k + r": & " + v for k, v in ident) + r" \\",
         r"\end{tabular}", "",
         r"\vspace{2.2em}",
         r"{\large\bfseries Раздел I. Учёт доходов" + (r" и расходов" if has_exp else "") + r"}", "",
         r"\vspace{8pt}",
         r"\begin{longtable}{" + cols + r"}",
         r"  \hline " + header, r"  \hline \endfirsthead",
         r"  \hline " + header, r"  \hline \endhead"]
    p += rows
    p += [total, r"  \hline", r"\end{longtable}", "",
          r"\vspace{1.2em}", note, "",
          r"\vspace{3em}",
          r"\begin{tabular}{@{}p{12cm}@{}}",
          r"  Подпись \hrulefill\ /" + _tex_escape(who[1]) + r"/ \\",
          r"\end{tabular}", r"\end{document}", ""]
    return "\n".join(p)


# ════════════════════════════════ CLI ════════════════════════════════
def _date(value: str | None) -> date | None:
    return datetime.strptime(value, "%Y-%m-%d").date() if value else None


def _operation(s: str) -> tuple:
    """Parse a 'date;document;description;income;expense' ledger row."""
    parts = (s.split(";") + ["", "", "", "", ""])[:5]
    inc = int(parts[3]) if parts[3].strip() else 0
    exp = int(parts[4]) if parts[4].strip() else 0
    return (parts[0] or "(дата)", parts[1] or "(№ док.)", parts[2], inc, exp)


def _taxpayer(a: argparse.Namespace) -> Taxpayer:
    if a.entity == "org":
        return Taxpayer(kind="org", name=a.name, inn=a.inn, kpp=a.kpp, ogrn=a.ogrn,
                        phone=a.phone, tax_authority_code=a.code, oktmo=a.oktmo, okved=a.okved)
    last, first, patr = ((a.name or "").split() + ["", "", ""])[:3]
    return Taxpayer(last, first, patr, inn=a.inn, ogrnip=a.ogrnip, phone=a.phone,
                    tax_authority_code=a.code, oktmo=a.oktmo, okved=a.okved)


def _filing(a: argparse.Namespace) -> Filing:
    return Filing(a.year, _taxpayer(a), regime=a.regime, income=a.income, expenses=a.expenses,
                  usn_object=a.object, region_rate=a.region_rate,
                  potential_income=a.potential_income, income_from_legal=a.income_legal,
                  advance_payments=a.advance, vat_input=a.vat_input,
                  employees=list(a.employee or []), is_msp=a.msp,
                  correction_number=a.correction)


def _add_common(p: argparse.ArgumentParser) -> None:
    p.add_argument("--year", type=int, required=True)
    p.add_argument("--entity", choices=["ip", "org"], default="ip", help="ИП or ООО")
    p.add_argument("--regime", choices=list(_REGIMES), default="osno")
    p.add_argument("--object", choices=["dohody", "dohody-rashody"], default="dohody",
                   help="УСН/АУСН object")
    p.add_argument("--income", type=int, default=0, help="revenue / доход, ₽")
    p.add_argument("--expenses", type=int, default=None, help="расходы, ₽ (ОСНО-ИП: documents)")
    p.add_argument("--region-rate", type=float, default=None, help="reduced regional УСН rate")
    p.add_argument("--potential-income", type=int, default=0, help="ПСН потенциальный доход, ₽")
    p.add_argument("--income-legal", type=int, default=0, help="НПД: доход от юрлиц/ИП, ₽")
    p.add_argument("--advance", type=int, default=0, help="авансы/уплаченный налог, ₽")
    p.add_argument("--vat-input", type=int, default=0, help="входящий НДС к вычету, ₽")
    p.add_argument("--employee", type=int, action="append", metavar="SALARY",
                   help="monthly gross salary of one employee (repeat per employee)")
    p.add_argument("--msp", action="store_true", help="МСП reduced payroll tariff")
    p.add_argument("--correction", type=int, default=0, help="amended-return number")
    p.add_argument("--name", default="", help='ФИО (ИП) or organisation name (ООО)')
    p.add_argument("--inn", default="")
    p.add_argument("--kpp", default="")
    p.add_argument("--ogrn", default="")
    p.add_argument("--ogrnip", default="")
    p.add_argument("--phone", default="")
    p.add_argument("--code", default="", help="код налогового органа")
    p.add_argument("--oktmo", default="")
    p.add_argument("--okved", default="62.01")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="taxkittie", description="Russian tax returns for an ИП or ООО, any regime")
    parser.add_argument("--version", action="version", version=f"TaxKittie {__version__}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    c = sub.add_parser("compute", help="compute the tax and print a bilingual summary")
    _add_common(c)
    c.add_argument("--filing-date", help="YYYY-MM-DD, for the late-filing fine")
    c.add_argument("--payment-date", help="YYYY-MM-DD, for пени")
    c.add_argument("--paid-before-filing", action="store_true",
                   help="tax + пени settled before filing → no ст. 122 fine")
    c.add_argument("--lang", choices=["ru", "en", "both"], default="both")

    x = sub.add_parser("xml", help="emit ФНС XML (3-НДФЛ / УСН)")
    _add_common(x)
    x.add_argument("--out", required=True, help="output .xml path")
    x.add_argument("--doc-date", help="YYYY-MM-DD (default: today)")

    b = sub.add_parser("book", help="emit the regime's ledger (КУД/КУДиР/86н) as XeLaTeX")
    _add_common(b)
    b.add_argument("--operation", action="append", metavar="D;DOC;DESC;INC;EXP",
                   help="ledger row 'date;document;description;income;expense' (repeatable)")
    b.add_argument("--out", required=True, help="output .tex path")
    b.add_argument("--doc-date", help="YYYY-MM-DD (default: today)")

    a = parser.parse_args(argv)
    f = _filing(a)

    if a.cmd == "compute":
        r = compute(f, filing_date=_date(a.filing_date), payment_date=_date(a.payment_date),
                    paid_before_filing=a.paid_before_filing)
        print(render(f, r, a.lang))
    elif a.cmd == "xml":
        r = compute(f)
        data = to_bytes(f, r, doc_date=_date(a.doc_date) or date.today())
        with open(a.out, "wb") as fh:
            fh.write(data)
        print(f"wrote {a.out} ({len(data)} bytes) — validate against the official XSD")
    elif a.cmd == "book":
        ops = [_operation(s) for s in (a.operation or [])]
        tex = build_book_tex(f, ops, doc_date=_date(a.doc_date) or date.today())
        with open(a.out, "w", encoding="utf-8") as fh:
            fh.write(tex)
        print(f"wrote {a.out} — compile on Windows with:  pdflatex {a.out}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
